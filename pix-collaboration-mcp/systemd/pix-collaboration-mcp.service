[Unit]
Description=PIX Collaboration Platform MCP Server (SSE)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pix-collaboration-mcp
ExecStart=/usr/bin/node dist/index.js --transport sse --port 3333
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3333
Environment=REDMINE_BASE_URL=https://rd.pixmoving.city

[Install]
WantedBy=multi-user.target
