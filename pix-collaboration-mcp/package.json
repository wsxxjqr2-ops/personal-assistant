{
  "name": "pix-collaboration-mcp",
  "version": "1.0.0",
  "description": "PIX/RUBYLOFT Collaboration Platform MCP Server (Redmine integration for issues and work-log tracking)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pix-collaboration-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:sse": "node dist/index.js --transport sse --port 3333",
    "dev": "tsc && node dist/index.js",
    "watch": "tsc -w"
  },
  "keywords": [
    "mcp",
    "redmine",
    "pixmoving",
    "collaboration",
    "timesheet"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
